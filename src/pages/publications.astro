---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const publications = (await getCollection("publications")).sort(
  (a, b) => b.data.year - a.data.year
);

const label = (slug: string) =>
  slug
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ")
    .replace(/^Machine Learning$/, "Machine learning")
    .replace(/^Clinical Informatics$/, "Clinical informatics");

// Extract all unique categories, with counts for the filter pills
const allCategories = [...new Set(publications.flatMap((pub) => pub.data.categories || []))].sort();
const categoryCounts = Object.fromEntries(
  allCategories.map((cat) => [cat, publications.filter((p) => p.data.categories.includes(cat)).length])
);
const allPublicationTypes = [...new Set(publications.map((pub) => pub.data.publicationType || "other"))].sort();
const totalCitations = publications.reduce((n, p) => n + (p.data.citations ?? 0), 0);
---

<BaseLayout title="Publications">
  <section class="flex flex-wrap items-end justify-between gap-8 pb-12 border-b border-gray-200">
    <div class="flex-[1_1_520px] min-w-0">
      <p class="eyebrow">Publications</p>
      <h1 class="mt-6 text-[clamp(40px,5vw,60px)] leading-[1.04] tracking-[-0.04em] font-medium text-gray-950">Papers &amp; preprints.</h1>
      <p class="mt-5 max-w-[560px] text-[17px] leading-relaxed text-gray-600">
        Machine learning for neuroscience and clinical medicine. Citation counts update weekly from Google Scholar.
      </p>
    </div>
    <dl class="flex gap-10">
      <div>
        <dt class="mono text-[11px] uppercase tracking-[0.12em] text-gray-400">Papers</dt>
        <dd class="mt-2 text-[32px] font-medium tracking-[-0.03em] text-gray-900">{publications.length}</dd>
      </div>
      <div>
        <dt class="mono text-[11px] uppercase tracking-[0.12em] text-gray-400">Citations</dt>
        <dd class="mt-2 text-[32px] font-medium tracking-[-0.03em] text-gray-900">{totalCitations}</dd>
      </div>
    </dl>
  </section>

  <!-- Filters and sorting -->
  <div class="mt-10 flex flex-wrap items-center justify-between gap-4">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by field">
      <button type="button" class="pill" data-category="" aria-pressed="true">
        All <span class="mono text-[11px] opacity-70">{publications.length}</span>
      </button>
      {allCategories.map((cat) => (
        <button type="button" class="pill" data-category={cat} aria-pressed="false">
          {label(cat)} <span class="mono text-[11px] opacity-70">{categoryCounts[cat]}</span>
        </button>
      ))}
    </div>
    <div class="flex flex-wrap gap-3">
      <label class="sr-only" for="type-filter">Type</label>
      <select id="type-filter" class="control">
        <option value="">All types</option>
        {allPublicationTypes.map((type) => (
          <option value={type}>{type.charAt(0).toUpperCase() + type.slice(1)}</option>
        ))}
      </select>
      <label class="sr-only" for="sort-by">Sort by</label>
      <select id="sort-by" class="control">
        <option value="year-desc">Newest first</option>
        <option value="year-asc">Oldest first</option>
        <option value="citations-desc">Most cited</option>
        <option value="citations-asc">Least cited</option>
      </select>
    </div>
  </div>

  <p class="mono mt-8 pb-4 border-b border-gray-200 text-xs text-gray-400" aria-live="polite">
    Showing <span id="shown-count">{publications.length}</span> of {publications.length}
  </p>

  <!-- Publications list -->
  <ol id="publications-list">
    {publications.map((pub) => (
      <li
        class="publication-item grid gap-x-8 gap-y-2 py-7 border-b border-gray-100 [grid-template-columns:64px_minmax(0,1fr)]"
        data-year={pub.data.year}
        data-citations={pub.data.citations || 0}
        data-categories={JSON.stringify(pub.data.categories || [])}
        data-type={pub.data.publicationType || "other"}
      >
        <span class="mono pt-1 text-[13px] text-gray-400">{pub.data.year}</span>
        <div class="min-w-0">
          <h2 class="text-lg font-medium leading-snug tracking-[-0.01em] text-gray-900">
            {pub.data.url ? (
              <a href={pub.data.url} target="_blank" rel="noopener" class="hover:text-white">
                {pub.data.title} <span aria-hidden="true" class="text-gray-400">↗</span>
              </a>
            ) : (
              pub.data.title
            )}
          </h2>
          <p class="authors mt-2 text-sm leading-relaxed text-gray-500" set:html={pub.data.authors} />
          <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
            {pub.data.venue && pub.data.venue !== "Unknown Venue" && (
              <span class="italic text-gray-600 mr-1">{pub.data.venue}</span>
            )}
            {pub.data.publicationType !== "other" && (
              <span class="mono text-[11px] uppercase tracking-[0.06em] text-[var(--accent)] border border-blue-300 rounded-md px-2 py-0.5">
                {pub.data.publicationType}
              </span>
            )}
            {pub.data.categories.map((cat) => (
              <span class="mono text-[11px] text-gray-600 bg-gray-100 border border-gray-300 rounded-md px-2 py-0.5">{label(cat)}</span>
            ))}
            {pub.data.citations ? (
              <span class="mono ml-auto text-xs text-gray-400">Cited by {pub.data.citations}</span>
            ) : null}
          </div>
          {pub.data.description && <p class="mt-3 text-sm leading-relaxed text-gray-600">{pub.data.description}</p>}
          {pub.data.pdf && (
            <a href={pub.data.pdf} class="mt-3 inline-flex items-center text-sm text-[var(--accent)]" target="_blank" rel="noopener">
              PDF &rarr;
            </a>
          )}
        </div>
      </li>
    ))}
  </ol>

  <!-- No results -->
  <div id="no-results" class="hidden py-16 text-center text-gray-500">
    <p class="text-lg">No publications match these filters.</p>
    <button id="clear-filters" type="button" class="btn btn-ghost mt-5">Clear filters</button>
  </div>
</BaseLayout>

<style>
  .control {
    height: 40px;
    padding: 0 12px;
    border-radius: 10px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    font-size: 14px;
  }

  .authors :global(strong) {
    color: var(--text);
    font-weight: 500;
  }
</style>

<script>
  const publications = Array.from(document.querySelectorAll<HTMLElement>(".publication-item"));
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>(".pill"));
  const sortSelect = document.getElementById("sort-by") as HTMLSelectElement;
  const typeFilter = document.getElementById("type-filter") as HTMLSelectElement;
  const publicationsList = document.getElementById("publications-list") as HTMLElement;
  const noResults = document.getElementById("no-results") as HTMLElement;
  const shownCount = document.getElementById("shown-count") as HTMLElement;
  const clearFiltersBtn = document.getElementById("clear-filters") as HTMLButtonElement;
  let category = "";

  function filterAndSort() {
    const typeValue = typeFilter.value;
    const visible = publications.filter((pub) => {
      const categories = JSON.parse(pub.dataset.categories || "[]");
      return (!category || categories.includes(category)) && (!typeValue || pub.dataset.type === typeValue);
    });

    const num = (el: HTMLElement, key: "year" | "citations") => parseInt(el.dataset[key] || "0");
    visible.sort((a, b) => {
      switch (sortSelect.value) {
        case "year-asc":
          return num(a, "year") - num(b, "year");
        case "citations-desc":
          return num(b, "citations") - num(a, "citations");
        case "citations-asc":
          return num(a, "citations") - num(b, "citations");
        default:
          return num(b, "year") - num(a, "year");
      }
    });

    publications.forEach((pub) => (pub.hidden = true));
    visible.forEach((pub) => {
      pub.hidden = false;
      publicationsList.appendChild(pub);
    });
    shownCount.textContent = String(visible.length);
    noResults.classList.toggle("hidden", visible.length > 0);
  }

  function setCategory(value: string) {
    category = value;
    pills.forEach((pill) => pill.setAttribute("aria-pressed", String(pill.dataset.category === value)));
    filterAndSort();
  }

  pills.forEach((pill) => pill.addEventListener("click", () => setCategory(pill.dataset.category ?? "")));
  sortSelect.addEventListener("change", filterAndSort);
  typeFilter.addEventListener("change", filterAndSort);
  clearFiltersBtn.addEventListener("click", () => {
    sortSelect.value = "year-desc";
    typeFilter.value = "";
    setCategory("");
  });
</script>
