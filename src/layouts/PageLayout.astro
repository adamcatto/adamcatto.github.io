---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<BaseLayout title={title} description={description}>
  {eyebrow && <p class="eyebrow mb-6">{eyebrow}</p>}
  <article class="prose">
    <slot />
  </article>
</BaseLayout>
