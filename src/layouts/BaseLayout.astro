---
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
import { url, isStaging } from "../lib/paths";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Adam Catto: agents, trustworthy AI, and RL environments" } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: url("/"), label: "About" },
  { href: url("/research"), label: "Research" },
  { href: url("/publications"), label: "Publications" },
  { href: url("/projects"), label: "Projects" },
  { href: url("/software"), label: "Software" },
  { href: url("/apps"), label: "App Studio" },
  { href: url("/writing"), label: "Writing" },
  { href: url("/learning"), label: "Learning" },
  { href: url("/bookshelf"), label: "Bookshelf", also: [url("/reading")] },
  { href: url("/cv"), label: "CV" },
  { href: url("/contact"), label: "Contact" },
];

const elsewhere = [
  { href: "https://github.com/adamcatto", label: "GitHub" },
  { href: "https://scholar.google.com/citations?user=wuJLVSYAAAAJ", label: "Scholar" },
  { href: "https://linkedin.com/in/adamcatto", label: "LinkedIn" },
  { href: "https://futureandever.substack.com", label: "Substack" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0B0D" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
      crossorigin="anonymous"
    />
    <link href={url("/pagefind/pagefind-ui.css")} rel="stylesheet" />
    <script is:inline src={url("/pagefind/pagefind-ui.js")}></script>
    {isStaging && <meta name="robots" content="noindex, nofollow" />}
    <title>{title} | Adam Catto</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <SiteHeader currentPath={currentPath} navLinks={navLinks} />

    <main class="flex-1 pt-16 pb-24 lg:pt-20 lg:pb-32">
      <div class="site-shell">
        <slot />
      </div>
    </main>

    <footer class="border-t border-gray-200">
      <div class="site-shell flex flex-wrap items-center justify-between gap-6 pt-10 pb-14">
        <div>
          <p class="text-sm text-gray-900">&copy; {new Date().getFullYear()} Adam Catto</p>
          <p class="mt-1.5 text-xs text-gray-500">All views are my own and do not represent those of my employer.</p>
          <p class="mono mt-1.5 text-xs text-gray-400">Built with Astro · Hosted on GitHub Pages</p>
        </div>
        <nav aria-label="Elsewhere" class="flex flex-wrap gap-6 text-sm">
          {elsewhere.map((link) => (
            <a href={link.href} class="muted-link" target="_blank" rel="noopener">{link.label}</a>
          ))}
          <a href="mailto:agocatto@gmail.com" class="muted-link">Email</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
